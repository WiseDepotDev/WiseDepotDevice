# /etc/wise-device/wise-device.conf —— 慧仓智控设备端配置示例（P4-04 配置外部化）
#
# 安装：
#   sudo install -d -m 755 /etc/wise-device
#   sudo install -m 600 wise-device.conf.example /etc/wise-device/wise-device.conf
#   sudo editor /etc/wise-device/wise-device.conf     # 至少填写 server_url / device_id / signature_secret
#
# 权限：本文件含请求签名密钥，必须 0600（owner = 运行 wise-device 的账号），不得 world-readable。
# 优先级：环境变量 > 本文件 > 源码内默认值（config.c 的实现与 config.h 的文档一致）。
#
# 等价环境变量（systemd 可用 Environment= 或 EnvironmentFile= 注入）：
#   WISE_SERVER_URL            覆盖 server_url
#   WISE_DEVICE_ID             覆盖 device_id
#   WISE_DEVICE_HEARTBEAT      覆盖 heartbeat_interval（秒）
#   WISE_API_SIGNATURE_SECRET  覆盖 signature_secret（**必须与服务端一致**）
#   WISE_ENCRYPTION_KEY        本地数据加密密钥（当前尚无消费方）
#   MQTT_HOST / MQTT_PORT / MQTT_USERNAME / MQTT_PASSWORD   MQTT 接入信息
#   WISE_RFID_SERIAL_PORT      覆盖 rfid_serial_port
#   WISE_RFID_BAUDRATE         覆盖 rfid_baudrate（>0；非法值忽略并告警）
#   WISE_RFID_POWER            覆盖 rfid_power（0..33；越界忽略并告警）
#   WISE_RFID_ADDRESS          覆盖 rfid_address（0..255，支持 0x 写法；越界忽略并告警）
#   WISE_RFID_LEGACY_FRAMES    覆盖 rfid_legacy_frames（0/1）
#
# 说明：MQTT 口令、加密密钥与签名密钥在源码内**没有任何默认值**（STD-SEC-01），
# 缺失时对应能力会被显式拒绝（签名请求直接中止并记 ERROR），不会退化成固定密钥。

# ---- 服务端 ----
# 设备注册 / 心跳 / 巡检上报的目标地址
server_url=http://127.0.0.1:8080

# 设备唯一标识（不填则取主机名）
device_id=wise-device-001

# ---- 心跳与轮询 ----
# 心跳间隔（秒）。服务端下发的默认值同为 1，可在服务端调整后用远端配置覆盖
heartbeat_interval=1

# ---- 日志 ----
log_path=/var/log/wise-device/wise-device.log
# DEBUG / INFO / WARN / ERROR
log_level=INFO

# ---- 运动参数（现场标定值） ----
move_speed_cm_s=19.7
motor_trim_a=0.9
motor_trim_b=-0.5
motor_trim_c=0.9
motor_trim_d=-0.5

# ---- RFID 读头（P4-12）----
# 串口设备：USB 转串口通常是 /dev/ttyUSB0，板载串口是 /dev/ttyS*；
# 用 `ls -l /dev/serial/by-id/` 可以拿到不随插拔变化的稳定路径。
rfid_serial_port=/dev/ttyUSB0

# 波特率：仅支持 9600 / 19200 / 38400 / 57600 / 115200（其他值会告警并回落到 57600）。
# 必须与读头实际波特率一致，否则表现为"命令写出去但读不到响应"。
rfid_baudrate=57600

# 功率（dBm，0..33）：仅在新帧路径（rfid_legacy_frames=0）下初始化时下发；
# 设为 0 表示不下发、沿用读头自身设定。
rfid_power=26

# 读头地址：0xFF = 广播（默认为此，单个读头场景够用）。
# 多读头共用一条总线时必须给每个读头配置各自的 0x00..0xFE 地址，否则会互相应答。
rfid_address=0xFF

# 旧帧路径开关：1 = 沿用历史行为（广播地址、readData 旧布局、初始化不下发功率），
# 0 = 新路径（按配置地址组帧、readData 按手册对齐并校验 EPC 为整字、初始化下发功率）。
# 现场首次切换新路径前，请先用 0 状态做一次真机回归（P4-12 的真机验证项）。
rfid_legacy_frames=1

# ---- 读头交付期命令（P4-18，默认不自动执行）----
# 地址与波特率属于"一次性写死"的命令：写错地址会让读头从总线上消失，
# 波特率还与宿主串口速率互为前提，因此**不在初始化时自动下发**。
# 需要用维护工具显式调用（设备端已提供 rfid_set_address() / rfid_set_baudrate()）：
#   1) 现场确认两侧速率一致后再下发 0x28（波特率）；
#   2) 多读头场景逐个下发 0x24（地址），之后把 rfid_address 改成对应单播地址。
# 功率（rfid_power）不同：它在 rfid_init 里按需自动下发（0x2F），无需人工介入。

# ---- 请求签名（必须配置） ----
# X-Signature 的 HMAC-SHA256 密钥，必须与服务端 wise.api.signature.secret
# （即服务端环境变量 WISE_API_SIGNATURE_SECRET）完全一致。
# 未配置时：签名请求不会被发出，日志会给出 ERROR 提示。
signature_secret=REPLACE_WITH_THE_SAME_SECRET_AS_SERVER
